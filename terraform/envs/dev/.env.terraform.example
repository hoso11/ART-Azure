# Service Principal credentials for the Terraform azurerm provider.
#
# Copy this file to `.env.terraform` and fill in real values.
# `.env.terraform` is gitignored — never commit real credentials.
#
#   cp .env.terraform.example .env.terraform
#   # edit .env.terraform with real values
#   source .env.terraform
#   terraform init && terraform plan && terraform apply
#
# These ARM_* variables are read directly by the azurerm provider, so you do
# NOT also need to set `subscription_id` / `tenant_id` in terraform.tfvars
# when this file is sourced. (If both are set, the .tfvars value wins.)

export ARM_CLIENT_ID="your-application-client-id"
export ARM_CLIENT_SECRET="your-client-secret-value"
export ARM_SUBSCRIPTION_ID="your-subscription-id"
export ARM_TENANT_ID="your-directory-tenant-id"
