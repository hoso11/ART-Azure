# ==============================================================================
# Azure App Settings for the Web App (ART).
# Every variable here is injected as an env var into EVERY container
# (main + all sidecars) by Azure. Set these in:
#   Azure Portal > App Service > Settings > Configuration > Application Settings.
# (Or via az cli — see AZURE_DEPLOYMENT.md.)
# ==============================================================================

# ---------- Docker Hub (used by docker-compose.azure.yml + scripts) ----------
DOCKERHUB_USERNAME=hoso30
IMAGE_TAG=latest

# ---------- Azure-specific ----------
# Tells Azure which port of the MAIN container to route public traffic to.
# Our main container is Next.js, listening on 3000.
WEBSITES_PORT=3000
# Keep the container resident even if there are no incoming requests.
WEBSITES_CONTAINER_START_TIME_LIMIT=600
WEBSITES_ENABLE_APP_SERVICE_STORAGE=false

# ---------- General ----------
APP_NAME=ART Manufacturing
APP_ENV=production
DEBUG=false
LOG_FORMAT=json

# ---------- Security / JWT ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-64-char-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Must include the public Azure URL — used by FastAPI CORS middleware.
ALLOWED_ORIGINS=https://art-front-cwdxfzhgcccvcjeh.germanywestcentral-01.azurewebsites.net

# ---------- Postgres sidecar ----------
# Picked up by the postgres:16-alpine image to initialize the DB on first boot.
POSTGRES_USER=art_user
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=art_manufacturing
# Used by the backend to connect. Sidecars share localhost.
DATABASE_URL=postgresql+asyncpg://art_user:replace-me@127.0.0.1:5432/art_manufacturing
DATABASE_URL_SYNC=postgresql://art_user:replace-me@127.0.0.1:5432/art_manufacturing

# ---------- Redis sidecar ----------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# ---------- MinIO sidecar ----------
STORAGE_BACKEND=minio
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=art-images
MINIO_USE_SSL=false
# Presigned image URLs embed this host. In Azure a localhost sidecar is
# not reachable from a browser — presigned URLs will 404 until you either
# (a) switch STORAGE_BACKEND=azure and configure AZURE_STORAGE_*,
# (b) or expose MinIO via a route rewrite (out of scope here).
MINIO_EXTERNAL_ENDPOINT=127.0.0.1:9000

# ---------- Email / SMTP (disabled by default) ----------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@art-manufacturing.com
SMTP_USE_TLS=false

# ---------- Frontend build-time args (baked in at image build) ----------
# These must be supplied as --build-arg to docker build for the frontend.
# Setting them as App Settings ALSO works for values the Node server reads at
# runtime; but NEXT_PUBLIC_* values that appear in client-side JS were frozen
# when the image was built.
NEXT_PUBLIC_APP_NAME=ART Manufacturing
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_MINIO_URL=

# Used at server startup for Next.js rewrites (main → backend sidecar).
INTERNAL_API_URL=http://127.0.0.1:8000
NODE_ENV=production
